{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rolled-up",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rolled-up-db",
      "database_id": "3e1770a9-b374-4f5d-921c-c28b0ac3d246"
    }
  ]
}
