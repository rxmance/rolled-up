{
  "name": "rolled-up",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rolled-up-db --binding DB --update-config",
    "db:migrate:remote": "wrangler d1 execute rolled-up-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute rolled-up-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
